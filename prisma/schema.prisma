// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillLevel {
  RK
  N_MINUS
  N
  N_PLUS
  S
  S_PLUS
  BG
  BG_PLUS
  P
}

enum SignUpStatus {
  CONFIRMED
  WAITLIST
  WITHDRAWN
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum TimeSlot {
  EARLY // 1 ทุ่ม
  LATE // 2 ทุ่ม
}

model Session {
  id                   String           @id @default(cuid())
  date                 DateTime
  venue                String
  startTime            String
  maxPlayers           Int
  courtsEarly          Int              @default(3)
  courtsLate           Int              @default(3)
  courtConfigNote      String?
  remark               String?
  status               SessionStatus    @default(OPEN)
  closedAt             DateTime?
  registrationClosedAt DateTime?
  // When the one-time "sign-ups are open" LINE post went out for this day, so
  // the Friday-11:00 cron and the admin button never announce it twice.
  registrationOpenNotifiedAt DateTime?
  lateOpenedAt         DateTime?
  openCourts           String? // comma-separated open court numbers; null = auto by clock
  // Admin override of the actual court baht per hour block (19,20,21,22 ICT),
  // comma-separated e.g. "400,600,520,0". Null = compute from open courts × rate.
  // Lets the bill match the venue's real charge when courts empty out late.
  courtHourCosts       String?
  // Per-person bill = entryFee + gamesPlayed × gameFee. Frozen at close so a
  // closed day reads back what it charged; null on an open day → use the club's
  // current AppSettings values.
  entryFee             Int?
  gameFee              Int?
  courtRateId          String?
  courtRate            CourtRate?       @relation(fields: [courtRateId], references: [id])
  courtHours           Float?
  shuttlecockTypeId    String?
  shuttlecockType      ShuttlecockType? @relation(fields: [shuttlecockTypeId], references: [id])
  shuttlecockQty       Int?
  courtCost            Int?
  shuttlecockCost      Int?
  totalCost            Int?
  // Frozen at close, like the prices above: what people were actually charged
  // must not move later when the club changes its current fee.
  feePerPerson         Int?
  createdAt            DateTime         @default(now())
  signUps              SignUp[]
  matches              Match[]
  pendingPairs         PendingPair[]

  // The home/live/roster pages all filter by status + date; the index turns
  // those from a full-table scan into a range lookup as the season grows.
  @@index([status, date])
  @@index([date])
}

model SignUp {
  id             String        @id @default(cuid())
  sessionId      String
  session        Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name           String
  skillLevel     SkillLevel
  status         SignUpStatus  @default(CONFIRMED)
  timeSlot       TimeSlot      @default(EARLY) // where they actually play (block they're seated in)
  preferredSlot  TimeSlot      @default(EARLY) // which block they wanted (for queue-jump when 1 ทุ่ม opens)
  slotNumber     Int?
  checkedInAt    DateTime?
  checkedOutAt   DateTime? // when they left (per-person billing clock stops)
  paidAt         DateTime? // when the admin marked their bill collected (null = ยอดค้าง)
  addedByAdmin   Boolean       @default(false) // true = admin quick-add, false = self sign-up
  withdrawnAt    DateTime? // when the name was withdrawn (for the withdrawal log)
  createdAt      DateTime      @default(now())
  matchSlots     MatchPlayer[]
  fixedPartnerId String?       @unique
  fixedPartner   SignUp?       @relation("FixedPair", fields: [fixedPartnerId], references: [id])
  fixedPartnerOf SignUp?       @relation("FixedPair")
  athleteId      String?
  athlete        Athlete?      @relation(fields: [athleteId], references: [id])

  // Postgres does not auto-index foreign keys. Nearly every read filters by
  // session (a day's roster/cost) or athlete (profile, leaderboard, quests).
  @@index([sessionId])
  @@index([athleteId])
}

model Athlete {
  id         String     @id @default(cuid())
  name       String     @unique
  skillLevel SkillLevel
  photoUrl   String? // small resized avatar stored as a data URL
  createdAt  DateTime   @default(now())
  // Cache version for /api/athletes/[id]/photo — bumping on update busts the URL.
  updatedAt  DateTime   @default(now()) @updatedAt
  signUps    SignUp[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  imageUrl  String? // resized image stored as a data URL
  active    Boolean  @default(true)
  kind      String   @default("announcement") // "announcement" | "rule" (กฎก๊วน)
  createdAt DateTime @default(now())
  // Cache version for /api/announcements/[id]/image.
  updatedAt DateTime @default(now()) @updatedAt
}

model CourtRate {
  id           String    @id @default(cuid())
  name         String
  pricePerHour Int
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model ShuttlecockType {
  id            String    @id @default(cuid())
  name          String
  pricePerPiece Int
  createdAt     DateTime  @default(now())
  sessions      Session[]
}

model AppSettings {
  id             String   @id @default("singleton")
  qrImageDataUrl String?
  // ค่าธรรมเนียมต่อคน (บาท) — บวกเข้าค่าคอร์ท ไม่แยกบรรทัด. Production has
  // defaulted to 0 since the column was reworked; the 5 here was drift, and a
  // fresh database should not invent a fee the club never set.
  feePerPerson   Int      @default(0)
  // Current per-person pricing. The bill is entryFee + gamesPlayed × gameFee;
  // the admin edits these on the Master page, and each day freezes them at close.
  entryFee       Int      @default(95)
  gameFee        Int      @default(25)
  updatedAt      DateTime @updatedAt
}

model Match {
  id         String        @id @default(cuid())
  sessionId  String
  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round      Int
  court      Int
  createdAt  DateTime      @default(now())
  // Live court flow: set when the admin ends the game. winnerTeam is 1 or 2
  // (recorded for stats; both teams rotate out regardless of who won).
  finishedAt DateTime?
  winnerTeam Int?
  players    MatchPlayer[]

  @@index([sessionId])
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  signUpId String
  signUp   SignUp @relation(fields: [signUpId], references: [id], onDelete: Cascade)
  team     Int

  @@index([matchId])
  @@index([signUpId])
}

// A foursome the admin has set aside for the next court, persisted so it
// survives refreshes and other players finishing their games. Unlike Match,
// a PendingPair is not bound to a court yet — it may even include someone
// still playing right now (their id is just earmarked); it can only be
// promoted into a real Match once all four are actually free and a court is
// open (see /api/sessions/[id]/pending-pairs/[pendingId]/book).
model PendingPair {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team1Ids  String[] // exactly 2 signUp ids
  team2Ids  String[] // exactly 2 signUp ids
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// An admin-created challenge over a date range — "come to every session in
// August", "be one of the first three to sign up this week".
//
// Only the definition is stored. Who has completed it is recomputed from match
// history on every read, exactly like EXP and achievements: the admin can edit
// or delete a finished game at any time, so a stored winner list would keep
// rewarding someone for a game that no longer exists.
model Quest {
  id        String   @id @default(cuid())
  title     String
  // Which rule decides completion — see QUEST_KINDS in lib/quests.ts. Kept as a
  // string rather than an enum so adding a rule needs no migration.
  kind      String
  icon      String   @default("🎯")
  // Inclusive start, exclusive end, both at UTC midnight like Session.date, so
  // consecutive months tile without overlapping.
  startDate DateTime
  endDate   DateTime
  // What the rule counts against: games, days, or how many top places pay out.
  target    Int?
  expReward Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Created by 20260726_quests and present in production, but it was missing
  // here — so the next `migrate dev` would have generated a DROP for it and
  // quietly cost every quest read its index.
  @@index([active, startDate])
}

// ---------------------------------------------------------------------------
// TUA TUENG GAMES — a one-day team event (6 teams, round robin + knockout).
// Kept entirely apart from the regular play-day tables above: nothing here feeds
// EXP, quests, the leaderboard or billing. Only raw data is stored (teams,
// lineups, set scores); standings, tie scores and knockout pairings are derived
// on read in lib/games/ so an edited result can never leave a stale total.
// See docs/superpowers/specs/2026-10-20-tua-tueng-games-design.md.
// ---------------------------------------------------------------------------

enum GamesStage {
  QUALIFIER
  SEMI // slot 1 = rank 1 vs 4, slot 2 = rank 2 vs 3
  FIFTH
  THIRD
  FINAL
}

model GamesEvent {
  id                     String      @id @default(cuid())
  name                   String
  // UTC midnight of the local (ICT) event date, same rule as Session.date.
  date                   DateTime
  qualifierRubberMinutes Int         @default(20)
  knockoutRubberMinutes  Int         @default(30)
  // Players see the event (home button, /games pages) only once published;
  // until then they get a "coming soon" screen and admins can preview.
  published              Boolean     @default(false)
  // Comma-separated team ids, used only when every tiebreak is still level.
  rankOverride           String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  teams                  GamesTeam[]
  ties                   GamesTie[]
  cards                  GamesCard[]
}

model GamesTeam {
  id        String            @id @default(cuid())
  eventId   String
  event     GamesEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seed      Int // 1–6, decides the round-robin pairings
  name      String
  color     String // hex, e.g. #dc2626
  logoUrl   String? // resized image stored as a data URL, like Athlete.photoUrl
  // Cache version for /api/games/teams/[id]/logo.
  updatedAt DateTime          @default(now()) @updatedAt
  members   GamesTeamMember[]
  cards     GamesCard[]

  @@unique([eventId, seed])
}

model GamesTeamMember {
  id        String    @id @default(cuid())
  teamId    String
  team      GamesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId String

  @@unique([teamId, athleteId])
  @@index([athleteId])
}

model GamesTie {
  id       String        @id @default(cuid())
  eventId  String
  event    GamesEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage    GamesStage
  round    Int? // 1–5, qualifier only
  slot     Int // which tie of the round (1–3) / which semi (1–2)
  startsAt String // "14:00", ICT, from the event's printed schedule
  courtA   Int
  courtB   Int
  // Qualifier: set at creation. Knockout: left null — derived on read from
  // the standings and the semi results.
  teamAId  String?
  teamBId  String?
  rubbers  GamesRubber[]
  cards    GamesCard[]

  @@index([eventId])
}

model GamesRubber {
  id            String    @id @default(cuid())
  tieId         String
  tie           GamesTie  @relation(fields: [tieId], references: [id], onDelete: Cascade)
  order         Int // 1–5 = คู่ที่
  court         Int
  // Athlete ids from the paper lineup; plain ids (no FK) like the rest of the
  // event data, remapped by the athlete-merge path.
  a1Id          String?
  a2Id          String?
  b1Id          String?
  b2Id          String?
  set1A         Int?
  set1B         Int?
  set2A         Int?
  set2B         Int?
  set3A         Int? // knockout only
  set3B         Int?
  finishedAt    DateTime? // set = this rubber has a result
  liveSet       Int? // set number being live-counted (1–3); null = not live
  liveStartedAt DateTime? // the live-count clock; informational only
  updatedAt     DateTime  @updatedAt

  @@index([tieId])
}

enum GamesCardKind {
  DOUBLE_DOWN
  STEAL
  SUBSTITUTION
}

// SECRET CARD a team played in one qualifier tie. Each team has one of each
// kind and may play at most one per tie; the bonus is derived on read.
model GamesCard {
  id        String        @id @default(cuid())
  eventId   String
  event     GamesEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tieId     String
  tie       GamesTie      @relation(fields: [tieId], references: [id], onDelete: Cascade)
  teamId    String
  team      GamesTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  kind      GamesCardKind
  order     Int // the pair (คู่ที่) it is played on; SUBSTITUTION: the first of the two swapped
  swapWith  Int? // SUBSTITUTION only: the pair it was swapped with
  createdAt DateTime      @default(now())

  @@unique([tieId, teamId])
  @@unique([eventId, teamId, kind])
  @@index([eventId])
}
